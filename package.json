{
  "name": "@dskripchenko/code-editor",
  "version": "0.0.1",
  "description": "A code editor for the browser with no framework: a text model with transactions, input through EditContext, only the visible lines drawn, highlighting by @dskripchenko/syntax",
  "keywords": [
    "code-editor",
    "editor",
    "text-editor",
    "editcontext",
    "web-component",
    "syntax-highlighting",
    "codemirror-alternative",
    "monaco-alternative"
  ],
  "homepage": "https://github.com/dskripchenko/code-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/code-editor.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/code-editor/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
